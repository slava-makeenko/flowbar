#!/bin/sh
# Регламент §8.2: стиль чинит форматтер, в ревью он не обсуждается.

set -eu

files="$(git diff --cached --name-only --diff-filter=ACM -- '*.swift')"
[ -z "$files" ] && exit 0

echo "$files" | tr '\n' '\0' | xargs -0 xcrun swift-format format --in-place
echo "$files" | tr '\n' '\0' | xargs -0 xcrun swift-format lint --strict
echo "$files" | tr '\n' '\0' | xargs -0 git add

# Компилятор границы слоёв не держит целиком: ADR-0007.
root="$(git rev-parse --show-toplevel)"
"$root/Scripts/check-layers.sh"
"$root/Scripts/check-tokens.sh"
