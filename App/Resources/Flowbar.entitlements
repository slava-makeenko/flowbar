<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Песочницы нет: дистрибуция через Developer ID, ADR-0016. Под песочницей
       запущенный `claude` не видел бы ни ~/.claude, ни Keychain, ни сети — а через него
       Flowbar спрашивает лимиты. Прежние данные из контейнера переносит
       SandboxContainerMigration. -->
</dict>
</plist>
